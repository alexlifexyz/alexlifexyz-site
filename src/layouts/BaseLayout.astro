---
import "../styles/global.css";
import BrandMark from "../components/BrandMark.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = "何占伟 / Alex，成都。11 年 Java 后端，公开可演示的 Java RAG：混合检索、带引用、依据不足拒答。",
  path,
} = Astro.props;

const navItems = [
  { href: "/projects", label: "项目" },
  { href: "/resume", label: "履历" },
  { href: "https://blog.alexai.top", label: "博客 ↗", external: true },
];

const liveItems = [
  { href: "https://rag.alexai.top", label: "RAG Lab" },
  { href: "https://chat.alexai.top", label: "Chat" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070A" />
    <script is:inline>
      (function () {
        var KEY = "alexai-theme";
        var pref = "system";
        try {
          pref = localStorage.getItem(KEY) || "system";
        } catch (e) {}
        if (pref !== "light" && pref !== "dark" && pref !== "system") pref = "system";
        var theme =
          pref === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : pref;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themePref = pref;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "light" ? "#F4F6F8" : "#05070A");
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="alexai.top" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/social-card.jpg", Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL("/social-card.jpg", Astro.url)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-frame">
      <header class="site-header">
        <div class="page-shell site-header-inner">
          <div class="header-brandline">
            <a class="brand" href="/">
              <span class="brand-mark"><BrandMark /></span>
              <span class="brand-title">ALEX<span class="brand-sep">::</span><span class="ai">AI</span></span>
            </a>
            <ThemeSwitch />
          </div>
          <nav class="site-nav" aria-label="Primary">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  aria-current={path === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <nav class="site-live" aria-label="Live systems">
            {
              liveItems.map((item) => (
                <a class="nav-live" href={item.href} target="_blank" rel="noopener noreferrer">
                  <i class="led" aria-hidden="true" />
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="page-shell">
          <div class="footer-inner">
            <div class="footer-brand">
              <a class="brand" href="/" style="margin-bottom: 1.25rem;">
                <span class="brand-mark"><BrandMark /></span>
                <span class="brand-title">ALEX<span class="brand-sep">::</span><span class="ai">AI</span></span>
              </a>
              <p style="line-height: 1.8; color: var(--text-muted); max-width: 340px;">
                何占伟 / Alex · 成都<br />
                11 年 Java 后端，正在把 RAG 做成可演示的工程。
              </p>
            </div>
            <div class="footer-nav-col">
              <h4>Systems</h4>
              <ul>
                <li><a href="https://rag.alexai.top" target="_blank" rel="noopener noreferrer">Java RAG Lab</a></li>
                <li><a href="https://chat.alexai.top" target="_blank" rel="noopener noreferrer">AI Assistant Suite</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="https://blog.alexai.top" target="_blank" rel="noopener noreferrer">Blog / 博客 ↗</a></li>
              </ul>
            </div>
            <div class="footer-nav-col">
              <h4>Profile</h4>
              <ul>
                <li><a href="/resume">Resume</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/now">Now</a></li>
                <li><a href="https://github.com/alexlifexyz" target="_blank" rel="noopener noreferrer">GitHub</a></li>
              </ul>
            </div>
          </div>
          <div class="footer-meta">
            <p>&copy; {new Date().getFullYear()} 何占伟 · alexai.top</p>
            <p>Astro · Cloudflare Pages</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
