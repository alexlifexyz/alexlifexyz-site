---
import BaseLayout from "../layouts/BaseLayout.astro";

const coreStrengths = [
  {
    title: "Java 后端与平台底座",
    body:
      "11 年 Java。在平安做过集团统一认证，在联想做过研发自动化平台，在国网做微服务脚手架和公共组件。习惯处理权限、稳定性、跨系统对接和线上问题，而不是只写业务 CRUD。",
  },
  {
    title: "可演示的 Java RAG",
    body:
      "公开项目 Java RAG Lab：文档解析、BM25 + 向量混合检索、回答带引用、证据不足拒答。Java 21 / Spring Boot 3，仓库和 rag.alexai.top 都可以点。用来说明我会把检索做成工程，而不是调一个 Chat API。",
  },
];

const experiencePhases = [
  {
    phase: "国网信通 · 后端开发工程师",
    period: "2024.10 - 至今 · 成都",
    summary:
      "参与集团微服务框架底座和公共组件，给业务项目组做接入和问题排查。",
    bullets: [
      "参与网关、定时任务、元数据校验、审计日志、权限等脚手架能力",
      "维护审计日志、加解密、ID 生成、文件上传下载等公共组件",
      "为项目组提供接入指导和线上问题定位",
    ],
  },
  {
    phase: "联想集团 · 资深开发工程师",
    period: "2021.09 - 2024.04",
    summary:
      "智能运维自动化平台，服务 15000+ 研发人员的远程访问、自动化执行和场景编排。",
    bullets: [
      "参与核心模块，优化自动化执行链路，相关场景执行效率约提升 20%",
      "基于 Guacamole 做远程桌面访问和文件传输",
      "参与场景脚本、上下游对接和交付支持",
    ],
  },
  {
    phase: "平安科技 · 高级开发工程师",
    period: "2018.05 - 2021.08",
    summary:
      "集团统一认证平台，以及香港政府 eID 项目后台模块。",
    bullets: [
      "统一认证覆盖 2000+ 子系统，支持约 30 万内勤与 100 万+ 业务人员接入",
      "架构优化后核心认证链路 QPS 做到约 20 万",
      "参与香港 eID 后台：授权认证、数据加密、文档生成",
    ],
  },
  {
    phase: "顺丰科技 · 开发工程师",
    period: "2017.03 - 2018.04",
    summary: "销售支持平台核心模块，面向约 30 万销售用户。",
    bullets: [
      "参与销售过程管理和内部系统对接",
      "商机数据量和慢 SQL 优化，提升处理效率",
    ],
  },
];

const techColumns = [
  {
    title: "Backend",
    items: [
      "Java 17 / 21, Spring Boot, Spring Cloud",
      "MySQL, Redis, RabbitMQ",
      "MyBatis / JOOQ, 并发与 JVM 调优",
    ],
  },
  {
    title: "AI / RAG（公开可验证）",
    items: [
      "混合检索：BM25 + 向量召回",
      "引用（chunk 级）与证据不足拒答",
      "LLM / Embedding 可替换客户端；演示可用内存向量",
    ],
  },
  {
    title: "Delivery",
    items: [
      "Docker, Linux, Git, Maven",
      "Cloudflare Tunnel / Pages",
      "Vue 3, TypeScript, Astro（本站）",
    ],
  },
];
---

<BaseLayout title="履历 | 何占伟" path="/resume">
  <div class="content-wrap" style="padding: 8rem 0 12rem;">
    <header style="margin-bottom: 6rem;">
      <span class="section-label mono">Resume</span>
      <h1 style="font-size: 3.5rem; letter-spacing: -0.05em; margin-bottom: 2rem;">何占伟</h1>
      <p class="hero-lead">
        <strong>Java 后端 / Java + AI 应用落地。</strong> 成都。11 年。<br/>
        西南科技大学 · 计算机科学与技术 · 本科。公开证据：<a href="https://rag.alexai.top">rag.alexai.top</a>
      </p>

      <div style="margin-top: 3rem; display: flex; flex-wrap: wrap; gap: 2.5rem; font-family: var(--mono); font-size: 0.85rem; color: var(--text-dim); background: var(--surface-muted); padding: 1.5rem 2rem; border-radius: var(--radius-sm); border: 1px solid var(--line);">
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <span style="color: var(--accent); font-weight: 600;">[Email]</span>
          <span><a href="mailto:Alexlifexyz@gmail.com" style="color: var(--text); font-weight: 500;">Alexlifexyz@gmail.com</a></span>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <span style="color: var(--accent); font-weight: 600;">[GitHub]</span>
          <span><a href="https://github.com/alexlifexyz" target="_blank" rel="noreferrer" style="color: var(--text); font-weight: 500;">github.com/alexlifexyz</a></span>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <span style="color: var(--accent); font-weight: 600;">[Location]</span>
          <span style="color: var(--text);">成都</span>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <span style="color: var(--accent); font-weight: 600;">[Status]</span>
          <span style="color: var(--text);">开放 Java / Java+AI 沟通</span>
        </div>
      </div>
    </header>

    <div style="display: grid; gap: 6rem;">
      <section>
        <h2 style="font-size: 1.5rem; margin-bottom: 3rem; border-bottom: 2px solid var(--text); padding-bottom: 0.75rem; border-left: none; padding-left: 0;">能核对的两件事</h2>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 4rem;">
          {coreStrengths.map((item) => (
            <div style="display: grid; gap: 0.5rem;">
              <h3 style="font-size: 1.15rem; color: var(--accent);">{item.title}</h3>
              <p style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.8;">{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 style="font-size: 1.5rem; margin-bottom: 3rem; border-bottom: 2px solid var(--text); padding-bottom: 0.75rem; border-left: none; padding-left: 0;">任职经历</h2>
        <div style="display: grid; gap: 4rem;">
          {experiencePhases.map((phase) => (
            <div class="experience-item">
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                <h3 style="margin-bottom: 0; font-size: 1.3rem;">{phase.phase}</h3>
                <span class="mono" style="font-size: 0.85rem; color: var(--accent); font-weight: 600;">{phase.period}</span>
              </div>
              <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem;">
                {phase.summary}
              </p>
              <ul style="list-style: none; padding-left: 0; display: grid; gap: 0.85rem; font-size: 0.95rem; color: var(--text-muted);">
                {phase.bullets.map((bullet) => (
                  <li style="display: flex; gap: 0.75rem; line-height: 1.7;">
                    <span style="color: var(--accent); font-weight: bold;">›</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 style="font-size: 1.5rem; margin-bottom: 3rem; border-bottom: 2px solid var(--text); padding-bottom: 0.75rem; border-left: none; padding-left: 0;">技能</h2>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rem;">
          {techColumns.map((column) => (
            <div>
              <h4 style="font-family: var(--mono); font-size: 0.85rem; text-transform: uppercase; color: var(--accent); font-weight: 600; margin-bottom: 1.5rem; letter-spacing: 0.05em;">{column.title}</h4>
              <div style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.95rem; color: var(--text);">
                {column.items.map((item) => (
                  <span style="border-left: 2px solid var(--line); padding-left: 0.75rem;">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 style="font-size: 1.5rem; margin-bottom: 3rem; border-bottom: 2px solid var(--text); padding-bottom: 0.75rem; border-left: none; padding-left: 0;">公开可点</h2>
        <div style="display: grid; gap: 1.5rem;">
          <p style="color: var(--text-muted); line-height: 1.8; font-size: 1rem;">
            下面两个都能打开。求职主证据是 Java RAG Lab。
          </p>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-top: 1rem;">
            <div class="panel" style="padding: 2rem;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                <span class="mono" style="font-size: 0.75rem; color: var(--accent); font-weight: 600;">PRIMARY</span>
                <span class="mono" style="font-size: 0.75rem; color: var(--text-dim);">Java 21 · RAG</span>
              </div>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Java RAG Lab</h3>
              <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;">
                文档问答。混合检索、引用、拒答。独立完成，2026。
              </p>
              <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem;" href="https://rag.alexai.top" target="_blank" rel="noreferrer">打开 Demo</a>
                <a class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;" href="/projects/java-rag-lab/">说明</a>
              </div>
            </div>

            <div class="panel" style="padding: 2rem;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                <span class="mono" style="font-size: 0.75rem; color: var(--text-dim); font-weight: 600;">ALSO LIVE</span>
                <span class="mono" style="font-size: 0.75rem; color: var(--text-dim);">Spring Boot · Vue 3</span>
              </div>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">AI Assistant Suite</h3>
              <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem;">
                SSE 对话助手，用来练编排和流式接口，不是主证据。
              </p>
              <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;" href="https://chat.alexai.top" target="_blank" rel="noreferrer">打开 Demo</a>
                <a class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;" href="/projects/ai-assistant-suite/">说明</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="rack" style="margin-top: 8rem; padding: 3rem; text-align: center;">
      <h3 style="font-size: 1.6rem; margin-bottom: 1rem;">沟通</h3>
      <p style="color: var(--text-muted); margin-bottom: 2.5rem; max-width: 580px; margin-inline: auto; line-height: 1.8;">
        成都。Java 后端或 Java + AI 应用落地都可以聊。
      </p>
      <div style="display: flex; justify-content: center; gap: 1.25rem; flex-wrap: wrap;">
        <a class="btn btn-primary" href="mailto:Alexlifexyz@gmail.com">邮件</a>
        <a class="btn btn-outline" href="https://github.com/alexlifexyz" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</BaseLayout>
