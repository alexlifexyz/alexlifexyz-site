---
import BaseLayout from "../layouts/BaseLayout.astro";

const coreStrengths = [
  {
    title: "Java 后端与平台底座",
    body:
      "11 年 Java。在平安做过集团统一认证（20万 QPS），在联想负责万人级 AIOps 自动化作业平台，在某国企单位主导微服务脚手架与平台工程底座。长期专注于高并发、分布式权限、中间件定制与生产高可用治理，具备系统化工程落地能力。",
  },
  {
    title: "可演示的 Java RAG",
    body:
      "公开项目 Java RAG Lab：文档解析、BM25 + 向量混合检索、回答带引用、依据不足防幻觉拒答。Java 21 / Spring Boot 3，仓库和 rag.alexai.top 都可以点。用来说明我会把检索做成工程，而不是调一个 Chat API。",
  },
];

const experiencePhases = [
  {
    phase: "某国企单位 · 后端开发工程师",
    period: "2024.10 - 至今 · 成都",
    summary:
      "负责集团微服务技术底座、通用网关与基础能力 SDK 研发，保障全网数十个核心业务工程高可靠运行与标准化交付。",
    bullets: [
      "负责微服务核心能力演进，封装微服务网关动态路由、细粒度 RBAC 权限控制、统一元数据校验与高吞吐分布式审计日志，沉淀标准化工程脚手架，实现新业务系统开箱即用",
      "设计并落地非侵入式 Spring Boot Starter 基础组件库，涵盖分布式唯一 ID（雪花算法优化）、国密/国际双模敏感数据加解密、大文件分片断点续传与分布式存储对接，统一全集团工程质量与安全规范",
      "主导框架底层技术问题攻坚与生产故障兜底，深度排查并解决多线程并发竞争、微服务通信偶发异常与内存泄漏隐患，显著缩短业务系统问题定位与恢复耗时",
    ],
  },
  {
    phase: "联想集团 · 资深开发工程师",
    period: "2021.09 - 2024.04",
    summary:
      "构建企业级 AIOps 智能运维与自动化作业平台，服务全球 15000+ 研发与运维人员的高并发作业执行与安全远程接入。",
    bullets: [
      "重构跨环境自动化执行与场景编排链路，针对复杂作业拓扑解耦任务依赖并优化分布式调度机制，消除下游超时与网络 IO 瓶颈，核心场景执行耗时缩短 20%，稳定支撑日均大规模任务调度",
      "深度定制 Apache Guacamole 底层协议网关，构建零客户端安装的 Web 终端跳板机，实现全球跨地域低延迟 RDP / SSH 访问、大文件高速安全传输以及全程会话录屏审计",
      "标准化统一运维 API 体系，打通 CMDB、监控告警、自动化部署等上下游流水线，沉淀 50+ 经典自动化运维场景模板，大幅削减跨团队基础设施协作成本",
    ],
  },
  {
    phase: "平安科技 · 高级开发工程师",
    period: "2018.05 - 2021.08",
    summary:
      "主导平安集团金融级统一身份认证平台（SSO）架构演进，并作为核心骨干攻坚香港政府 eID 跨境数字身份系统。",
    bullets: [
      "核心承载集团 2000+ 异构子系统及 130 万+（30 万内勤 + 100 万业务员）高频身份准入；重构核心认证鉴权链路，引入多级缓存防穿透、Token 本地极速验签与自适应限流熔断，峰值吞吐量突破 20 万 QPS，历年大促与早会高峰平稳运行零故障",
      "基于 OAuth 2.0 / OIDC / SAML 工业标准构建跨多云、多租户的统一接入网关，完善跨系统动态权限漫游与无感会话刷新机制，端到端认证响应时间降至亚毫秒级",
      "参与香港特别行政区政府级 eID 身份认证后台系统研发，严格遵从国际高等级数据安全规范，实现双向 TLS 强身份校验、高强度敏感数据密态流转与防篡改文档生成，顺利通过最高等级外部安全审计并如期投产",
    ],
  },
  {
    phase: "顺丰科技 · 开发工程师",
    period: "2017.03 - 2018.04",
    summary:
      "负责顺丰全网销售支持平台核心业务域研发，支撑全国 30 万一线销售与营销大军的高频日常作业。",
    bullets: [
      "负责全流程商机流转与销售协同核心链路，抽象并重构复杂客户-商机-合同全生命周期状态机模型，打通顺丰速运内部多套异构管理系统的跨域实时同步",
      "针对海量历史商机数据沉淀引发的数据库性能瓶颈，开展 SQL 深度重构、冷热数据分层归档与高频查询多维复合索引设计，核心查询 P99 耗时从秒级降低至 200ms 以内，彻底消除高峰期系统卡顿",
    ],
  },
];

const techColumns = [
  {
    title: "Backend",
    items: [
      "Java 17 / 21, Spring Boot, Spring Cloud",
      "MySQL, Redis, RabbitMQ",
      "MyBatis / JOOQ, 并发与 JVM 调优",
    ],
  },
  {
    title: "AI / RAG（公开可验证）",
    items: [
      "混合检索：BM25 + 向量召回",
      "引用（chunk 级）与依据不足防幻觉拒答",
      "LLM / Embedding 可替换客户端；演示可用内存向量",
    ],
  },
  {
    title: "Delivery",
    items: [
      "Docker, Linux, Git, Maven",
      "Cloudflare Tunnel / Pages",
      "Vue 3, TypeScript, Astro（本站）",
    ],
  },
];
---

<BaseLayout title="履历 | 何占伟" path="/resume">
  <div class="content-wrap page-block">
    <header class="page-head">
      <div class="page-head-row">
        <span class="section-label mono">Resume</span>
        <button class="btn btn-outline btn-compact print-hide" type="button" id="print-resume">
          打印 / PDF
        </button>
      </div>
      <h1 class="page-title">何占伟</h1>
      <p class="hero-lead">
        <strong>Java 后端 / Java + AI 应用落地。</strong> 成都。11 年。<br/>
        西南科技大学 · 计算机科学与技术 · 本科。在线演示：<a href="https://rag.alexai.top">rag.alexai.top</a>
      </p>

      <div class="resume-meta">
        <div class="resume-meta-item">
          <span class="resume-meta-key">[Email]</span>
          <a href="mailto:Alexlifexyz@gmail.com">Alexlifexyz@gmail.com</a>
        </div>
        <div class="resume-meta-item">
          <span class="resume-meta-key">[GitHub]</span>
          <a href="https://github.com/alexlifexyz" target="_blank" rel="noreferrer">github.com/alexlifexyz</a>
        </div>
        <div class="resume-meta-item">
          <span class="resume-meta-key">[Location]</span>
          <span>成都</span>
        </div>
        <div class="resume-meta-item">
          <span class="resume-meta-key">[Status]</span>
          <span>开放 Java / Java+AI 沟通</span>
        </div>
      </div>
    </header>

    <div class="resume-stack">
      <section>
        <h2 class="resume-h2">能核对的两件事</h2>
        <div class="resume-cols-2">
          {coreStrengths.map((item) => (
            <div class="resume-point">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="resume-h2">任职经历</h2>
        <div class="resume-timeline">
          {experiencePhases.map((phase) => (
            <div class="experience-item">
              <div class="experience-head">
                <h3>{phase.phase}</h3>
                <span class="mono experience-period">{phase.period}</span>
              </div>
              <p class="experience-summary">{phase.summary}</p>
              <ul class="experience-bullets">
                {phase.bullets.map((bullet) => (
                  <li>
                    <span aria-hidden="true">›</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="resume-h2">技能</h2>
        <div class="resume-cols-3">
          {techColumns.map((column) => (
            <div>
              <h4 class="resume-col-title">{column.title}</h4>
              <div class="resume-col-items">
                {column.items.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="resume-h2">在线系统</h2>
        <p class="resume-note">
          均已上线运行，支持直接体验。核心代表作为 Java RAG Lab。
        </p>
        <div class="resume-cols-2 resume-live-grid">
          <div class="panel resume-project">
            <div class="resume-project-meta">
              <span class="mono resume-project-flag">PRIMARY</span>
              <span class="mono">Java 21 · RAG</span>
            </div>
            <h3>Java RAG Lab</h3>
            <p>文档问答。混合检索、引用、防幻觉拒答。独立完成，2026。</p>
            <div class="resume-project-actions print-hide">
              <a class="btn btn-primary btn-compact" href="https://rag.alexai.top" target="_blank" rel="noreferrer">打开 Demo</a>
              <a class="btn btn-outline btn-compact" href="/projects/java-rag-lab/">说明</a>
            </div>
            <p class="print-only mono">https://rag.alexai.top</p>
          </div>

          <div class="panel resume-project">
            <div class="resume-project-meta">
              <span class="mono">ALSO LIVE</span>
              <span class="mono">Spring Boot · Vue 3</span>
            </div>
            <h3>AI Assistant Suite</h3>
            <p>SSE 流式对话助手，演示大模型应用编排与会话上下文管理。</p>
            <div class="resume-project-actions print-hide">
              <a class="btn btn-outline btn-compact" href="https://chat.alexai.top" target="_blank" rel="noreferrer">打开 Demo</a>
              <a class="btn btn-outline btn-compact" href="/projects/ai-assistant-suite/">说明</a>
            </div>
            <p class="print-only mono">https://chat.alexai.top</p>
          </div>
        </div>
      </section>
    </div>

    <div class="rack resume-cta">
      <h3>沟通</h3>
      <p>成都。Java 后端或 Java + AI 应用落地都可以聊。</p>
      <div class="resume-cta-actions print-hide">
        <a class="btn btn-primary" href="mailto:Alexlifexyz@gmail.com">邮件</a>
        <a class="btn btn-outline" href="https://github.com/alexlifexyz" target="_blank" rel="noreferrer">GitHub</a>
      </div>
      <p class="print-only mono">Alexlifexyz@gmail.com · github.com/alexlifexyz</p>
    </div>
  </div>

  <script is:inline>
    document.getElementById("print-resume")?.addEventListener("click", function () {
      window.print();
    });
  </script>
</BaseLayout>
