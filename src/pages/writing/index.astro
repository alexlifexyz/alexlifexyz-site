---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WeChatCard from "../../components/WeChatCard.astro";
import { CATEGORIES, normalizeCategory, getCategoryMeta } from "../../utils/categories";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Pinned / Featured posts
const featuredPosts = allPosts.filter((p) => p.data.pinned || p.data.featured).slice(0, 3);

// Category counts
const categoryCounts: Record<string, number> = {
  "all": allPosts.length,
  "ai-engineering": 0,
  "architecture": 0,
  "insights": 0,
  "essays": 0,
};

allPosts.forEach((post) => {
  const norm = normalizeCategory(post.data.category);
  categoryCounts[norm] = (categoryCounts[norm] || 0) + 1;
});

// Tags frequency
const tagMap = new Map<string, number>();
allPosts.forEach((post) => {
  (post.data.tags || []).forEach((t) => {
    tagMap.set(t, (tagMap.get(t) || 0) + 1);
  });
});
const sortedTags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15);
---

<BaseLayout title="技术专栏 & 个人思考 | 何占伟 / Alex" path="/writing">
  <div class="content-wrap blog-wrap">
    <!-- Header Hero -->
    <header class="blog-header">
      <div class="blog-header-top">
        <span class="section-label mono">Alex's Digital Garden</span>
        <div class="blog-header-links">
          <a href="/archive" class="header-link mono">时间归档 →</a>
          <a href="/rss.xml" target="_blank" class="header-link mono rss-link">RSS 订阅 ↗</a>
        </div>
      </div>
      <h1 class="blog-title">技术沉淀与思考</h1>
      <p class="hero-lead">
        11 年 Java 后端老兵，记录 AI 时代下的工程实战、生产高可用架构与真实生活随笔。
        不写空洞概念，只沉淀可复用的实战经验与真凭实据的工程判断。
      </p>
    </header>

    <!-- Featured Pinned Section -->
    {
      featuredPosts.length > 0 && (
        <section class="featured-section">
          <div class="section-badge mono">精选必读</div>
          <div class="featured-grid">
            {featuredPosts.map((post) => {
              const cat = getCategoryMeta(post.data.category);
              return (
                <a href={`/writing/${post.slug}/`} class="featured-card">
                  <div class="featured-top">
                    <span class="cat-pill" style={`color: ${cat.color}; background: color-mix(in srgb, ${cat.color} 12%, transparent);`}>
                      {cat.name}
                    </span>
                    <span class="featured-date mono">
                      {post.data.pubDate.toLocaleDateString("zh-CN", { month: "short", day: "numeric" })}
                    </span>
                  </div>
                  <h3 class="featured-title">{post.data.title}</h3>
                  <p class="featured-desc">{post.data.description}</p>
                  <div class="featured-footer mono">
                    <span>阅读全文 →</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- Main Layout with Two Columns -->
    <div class="blog-main">
      <div class="posts-column">
        <!-- Controls: Category Filter Tabs & View Switcher -->
        <div class="filter-bar">
          <div class="category-tabs" id="category-tabs">
            <button class="cat-tab active" data-cat="all">
              全部 <span class="tab-count">{categoryCounts["all"]}</span>
            </button>
            <button class="cat-tab" data-cat="ai-engineering">
              AI 工业落地 <span class="tab-count">{categoryCounts["ai-engineering"]}</span>
            </button>
            <button class="cat-tab" data-cat="architecture">
              Java 架构 <span class="tab-count">{categoryCounts["architecture"]}</span>
            </button>
            <button class="cat-tab" data-cat="insights">
              行业观察 <span class="tab-count">{categoryCounts["insights"]}</span>
            </button>
            <button class="cat-tab" data-cat="essays">
              随笔生活 <span class="tab-count">{categoryCounts["essays"]}</span>
            </button>
          </div>

          <div class="view-switcher" id="view-switcher">
            <button class="view-btn active" data-view="card" title="卡片摘要视图" aria-label="卡片视图">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            </button>
            <button class="view-btn" data-view="compact" title="紧凑列表视图" aria-label="紧凑视图">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            </button>
          </div>
        </div>

        <!-- Posts Container -->
        <div class="posts-container view-card" id="posts-container">
          {
            allPosts.map((post) => {
              const normCat = normalizeCategory(post.data.category);
              const cat = getCategoryMeta(post.data.category);
              const dateFormatted = post.data.pubDate
                .toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })
                .replace(/\//g, ".");
              return (
                <article class="post-item" data-category={normCat}>
                  <div class="post-date mono">{dateFormatted}</div>
                  <div class="post-content">
                    <a href={`/writing/${post.slug}/`} class="post-title-link">
                      <h3 class="post-title">{post.data.title}</h3>
                    </a>
                    <p class="post-desc">{post.data.description}</p>
                    <div class="post-meta">
                      <span class="cat-tag" style={`color: ${cat.color}; background: color-mix(in srgb, ${cat.color} 10%, transparent);`}>
                        {cat.name}
                      </span>
                      {post.data.tags &&
                        post.data.tags.map((t) => (
                          <a href={`/tags/${t}`} class="tag" style="text-decoration: none;">
                            #{t}
                          </a>
                        ))}
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

        <!-- Empty state when no matches -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <p>该分类下暂无文章，敬请期待更新。</p>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="blog-sidebar">
        <WeChatCard variant="sidebar" />

        <!-- Tag Cloud -->
        <div class="sidebar-box">
          <div class="sidebar-box-header">
            <span class="sidebar-box-title mono">热门标签</span>
          </div>
          <div class="tag-cloud">
            {sortedTags.map(([tag, count]) => (
              <a href={`/tags/${tag}`} class="cloud-tag">
                #{tag} <span class="tag-count mono">{count}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Digital Garden Status Box -->
        <div class="sidebar-box garden-box">
          <div class="garden-head">
            <span class="garden-dot"></span>
            <span class="mono" style="font-size: 0.8rem; font-weight: 600;">数字花园维护中</span>
          </div>
          <p style="font-size: 0.8rem; line-height: 1.6; color: var(--text-muted); margin: 0.5rem 0 0 0;">
            包含 100+ 篇公众号持续沉淀的高可用架构、AI 实操与职场反思。持续更新中。
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const tabs = document.querySelectorAll(".cat-tab");
    const posts = document.querySelectorAll(".post-item");
    const empty = document.getElementById("empty-state");
    const viewBtns = document.querySelectorAll(".view-btn");
    const container = document.getElementById("posts-container");

    // Category filter logic
    function setCategory(cat) {
      tabs.forEach((t) => {
        t.classList.toggle("active", t.dataset.cat === cat);
      });
      let visibleCount = 0;
      posts.forEach((p) => {
        const match = cat === "all" || p.dataset.category === cat;
        p.style.display = match ? "" : "none";
        if (match) visibleCount++;
      });
      if (empty) {
        empty.style.display = visibleCount === 0 ? "block" : "none";
      }
    }

    tabs.forEach((t) => {
      t.addEventListener("click", () => {
        const cat = t.dataset.cat || "all";
        setCategory(cat);
      });
    });

    // View switch logic (card vs compact)
    const VIEW_KEY = "alexai-blog-view";
    const savedView = localStorage.getItem(VIEW_KEY) || "card";
    function setView(view) {
      viewBtns.forEach((b) => b.classList.toggle("active", b.dataset.view === view));
      if (container) {
        container.classList.toggle("view-card", view === "card");
        container.classList.toggle("view-compact", view === "compact");
      }
      try {
        localStorage.setItem(VIEW_KEY, view);
      } catch (e) {}
    }

    viewBtns.forEach((b) => {
      b.addEventListener("click", () => {
        setView(b.dataset.view || "card");
      });
    });
    setView(savedView);

    // Read URL param if exists (?cat=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialCat = urlParams.get("cat");
    if (initialCat) {
      setCategory(initialCat);
    }
  })();
</script>

<style>
  .blog-wrap {
    padding: 5rem 0 9rem;
  }

  .blog-header {
    margin-bottom: 3.5rem;
  }

  .blog-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .blog-header-links {
    display: flex;
    gap: 1.25rem;
  }

  .header-link {
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .header-link:hover {
    opacity: 0.8;
  }

  .blog-title {
    font-size: 3.25rem;
    letter-spacing: -0.05em;
    margin: 0 0 1.5rem 0;
    color: var(--text);
  }

  /* Featured Section */
  .featured-section {
    margin-bottom: 4.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .section-badge {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  .featured-card {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .featured-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .cat-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .featured-date {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .featured-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }

  .featured-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-footer {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 500;
  }

  /* Main Layout */
  .blog-main {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 960px) {
    .blog-main {
      grid-template-columns: 1fr;
    }
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .category-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cat-tab {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cat-tab:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .cat-tab.active {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent);
    font-weight: 500;
  }

  .tab-count {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .cat-tab.active .tab-count {
    color: var(--accent);
  }

  .view-switcher {
    display: flex;
    gap: 0.25rem;
    background: var(--surface);
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .view-btn {
    background: transparent;
    border: none;
    font-size: 0.9rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .view-btn:hover {
    opacity: 0.9;
  }

  .view-btn.active {
    opacity: 1;
    background: var(--surface-subtle);
  }

  /* Posts Container */
  .posts-container {
    display: flex;
    flex-direction: column;
  }

  /* Card View Styles */
  .view-card .post-item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .view-card .post-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .post-date {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-top: 0.25rem;
  }

  .post-title-link {
    text-decoration: none;
  }

  .post-title {
    font-size: 1.4rem;
    color: var(--text);
    margin: 0 0 0.85rem 0;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .post-title:hover {
    color: var(--accent);
  }

  .post-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1.25rem 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .cat-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  /* Compact View Styles */
  .view-compact .post-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .view-compact .post-date {
    min-width: 5.5rem;
    margin: 0;
  }

  .view-compact .post-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .view-compact .post-title {
    font-size: 1.05rem;
    margin: 0;
    flex: 1;
    min-width: 220px;
  }

  .view-compact .post-desc {
    display: none;
  }

  .view-compact .post-meta .tag {
    display: none;
  }

  /* Empty state */
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    color: var(--text-dim);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
    margin-top: 2rem;
  }

  /* Sidebar */
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-box {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .sidebar-box-header {
    margin-bottom: 1rem;
  }

  .sidebar-box-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cloud-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    background: var(--surface-subtle);
    border: 1px solid var(--line);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .cloud-tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .garden-box {
    background: var(--surface-subtle);
    border-style: dashed;
  }

  .garden-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .garden-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.4);
  }
</style>
