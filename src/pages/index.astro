---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPipeline from "../components/HeroPipeline.astro";
import LiveRack from "../components/LiveRack.astro";
import StatusChips from "../components/StatusChips.astro";

const projects = await getCollection("projects");
const rag = projects.find((p) => p.slug === "java-rag-lab");
const chat = projects.find((p) => p.slug === "ai-assistant-suite");
---

<BaseLayout
  title="何占伟 / Alex — Java 后端 · Agent 与 AI 落地"
  description="何占伟 / Alex，成都。11 年 Java 后端，做 Agent 与 AI 落地。线上有对话助手与可核对的 RAG。"
  path="/"
>
  <section class="hero">
    <div class="page-shell hero-identity">
      <div class="hero-content">
        <p class="hero-kicker">何占伟 · 成都 · alexai.top</p>
        <StatusChips />
        <h1>11 年 Java 后端，<br />做 Agent 与 AI 落地。</h1>
        <p class="hero-lead">
          联想、平安、顺丰做过认证和自动化平台。线上有对话 Agent，也有能引用、能拒答的 RAG。人在成都，Java 后端和 Agent 方向都可以谈。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://chat.alexai.top" target="_blank" rel="noopener noreferrer">
            打开 Chat
          </a>
          <a class="btn btn-outline" href="https://rag.alexai.top" target="_blank" rel="noopener noreferrer">
            打开 RAG Lab
          </a>
          <a class="btn btn-outline" href="/resume">查看履历</a>
          <button class="btn btn-outline btn-share" type="button" id="share-site-btn" aria-label="分享本站链接">
            <svg viewBox="0 0 24 24" fill="none" width="15" height="15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span class="share-btn-text">分享</span>
          </button>
        </div>
      </div>
      <HeroPipeline />
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById("share-site-btn");
      if (!btn) return;
      btn.addEventListener("click", async function () {
        var textSpan = btn.querySelector(".share-btn-text");
        var shareUrl = window.location.origin + "/?v=4";
        var shareData = {
          title: "何占伟 / Alex — Java 后端 · Agent 与 AI 落地",
          text: "何占伟 / Alex，成都。11 年 Java 后端，做 Agent 与 AI 落地。",
          url: shareUrl,
        };

        if (navigator.share && /mobile|android|iphone|ipad|micromessenger|weixin/i.test(navigator.userAgent)) {
          try {
            await navigator.share(shareData);
            return;
          } catch (err) {
            if (err.name === "AbortError") return;
          }
        }

        function feedback(msg) {
          if (textSpan) textSpan.textContent = msg;
          setTimeout(function () {
            if (textSpan) textSpan.textContent = "分享";
          }, 2200);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(shareUrl).then(function () {
            feedback("链接已复制");
          }).catch(function () {
            feedback("请复制网址");
          });
        } else {
          feedback("请复制网址");
        }
      });
    })();
  </script>

  <section class="section band">
    <div class="page-shell">
      <div class="section-header section-header-row">
        <div>
          <span class="section-label mono">Live Production</span>
          <h2>在线系统</h2>
        </div>
        <a href="/projects" class="section-link">全部项目</a>
      </div>

      <div class="live-grid">
        {
          rag && (
            <LiveRack
              variant="rag"
              title={rag.data.title}
              serviceId="svc.rag"
              kicker="BM25 ∥ Vector → RRF → Cite | Refuse"
              summary={rag.data.summary}
              href={rag.data.links?.demo ?? "https://rag.alexai.top"}
              detailHref={`/projects/${rag.slug}/`}
              stack={rag.data.stack}
            />
          )
        }
        {
          chat && (
            <LiveRack
              variant="chat"
              title={chat.data.title}
              serviceId="svc.chat"
              kicker="token stream · session memory · zero-trust edge"
              summary={chat.data.summary}
              href={chat.data.links?.demo ?? "https://chat.alexai.top"}
              detailHref={`/projects/${chat.slug}/`}
              stack={chat.data.stack}
            />
          )
        }
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="page-shell now-split">
      <div>
        <span class="section-label mono">Now</span>
        <h2>正在关注</h2>
        <p style="margin-top: 1.25rem; font-size: 1.05rem; color: var(--text-muted); line-height: 1.8;">
          公开主线是 Agent 与 AI 落地。对话助手和可核对的 RAG 都在线上，站点本身也在迭代。
        </p>
        <div class="now-actions">
          <a class="btn btn-outline" href="/resume">查看履历</a>
          <a class="btn btn-outline" href="/now">详细状态</a>
          <span class="mono now-updated">Last updated: 2026.09</span>
        </div>
      </div>
      <div class="rack now-panel">
        <div class="mono" style="font-size: 0.72rem; letter-spacing: 0.12em; color: var(--signal); margin-bottom: 1rem; text-transform: uppercase;">
          // stack · current
        </div>
        <div class="now-grid">
          <span style="color: var(--text-dim);">[LLM]</span>
          <span>DeepSeek API / 可替换客户端</span>
          <span style="color: var(--text-dim);">[ARCH]</span>
          <span>Agent · RAG · Citations</span>
          <span style="color: var(--text-dim);">[LANG]</span>
          <span>Java 21 / Spring Boot 3</span>
          <span style="color: var(--text-dim);">[INFRA]</span>
          <span>Docker / Cloudflare Tunnel</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
