---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPipeline from "../components/HeroPipeline.astro";
import LiveRack from "../components/LiveRack.astro";
import StatusChips from "../components/StatusChips.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const featuredPosts = posts.slice(0, 3);

const projects = await getCollection("projects");
const rag = projects.find((p) => p.slug === "java-rag-lab");
const chat = projects.find((p) => p.slug === "ai-assistant-suite");
const rest = projects.filter(
  (p) => p.slug !== "java-rag-lab" && p.slug !== "ai-assistant-suite",
);
---

<BaseLayout title="何占伟 / Alex — Java + RAG" path="/">
  <section class="hero">
    <div class="page-shell hero-identity">
      <div class="hero-content">
        <p class="hero-kicker">何占伟 · 成都 · alexai.top</p>
        <StatusChips />
        <h1>11 年 Java 后端，<br />正在把 RAG 做成可演示的工程。</h1>
        <p class="hero-lead">
          在联想、平安、顺丰做过认证和自动化平台。现在公开打磨 Java RAG Lab：混合检索、回答带引用、证据不足就拒答。成都，开放 Java + AI 落地方向沟通。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://rag.alexai.top" target="_blank" rel="noopener noreferrer">
            打开 RAG Lab
          </a>
          <a class="btn btn-outline" href="/resume">查看履历</a>
        </div>
      </div>
      <HeroPipeline />
    </div>
  </section>

  <section class="section band">
    <div class="page-shell">
      <div class="section-header">
        <span class="section-label mono">Live Production</span>
        <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem;">
          <h2>在线系统</h2>
          <a href="/projects" class="section-link">VIEW ALL -></a>
        </div>
      </div>

      <div class="live-grid">
        {
          rag && (
            <LiveRack
              variant="rag"
              title={rag.data.title}
              serviceId="svc.rag"
              kicker="BM25 ∥ Vector → RRF → Cite | Refuse"
              summary={rag.data.summary}
              href={rag.data.links?.demo ?? "https://rag.alexai.top"}
              detailHref={`/projects/${rag.slug}/`}
              stack={rag.data.stack}
            />
          )
        }
        {
          chat && (
            <LiveRack
              variant="chat"
              title={chat.data.title}
              serviceId="svc.chat"
              kicker="token stream · session memory · zero-trust edge"
              summary={chat.data.summary}
              href={chat.data.links?.demo ?? "https://chat.alexai.top"}
              detailHref={`/projects/${chat.slug}/`}
              stack={chat.data.stack}
            />
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-shell">
      <div class="section-header">
        <span class="section-label mono">Featured Writing</span>
        <div style="display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem;">
          <h2>精选文章</h2>
          <a href="/writing" class="section-link">VIEW ALL -></a>
        </div>
      </div>

      <div class="item-list">
        {
          featuredPosts.map((post) => (
            <div class="list-item">
              <div class="item-date">
                {post.data.pubDate
                  .toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })
                  .replace(/\//g, ".")}
              </div>
              <div class="item-body">
                <a href={`/writing/${post.slug}/`} style="text-decoration: none;">
                  <h3>{post.data.title}</h3>
                </a>
                <p>{post.data.description}</p>
                <div class="tag-row">
                  <span class="tag" style="background: var(--signal-dim); color: var(--signal); border-color: transparent;">
                    {post.data.category}
                  </span>
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    rest.length > 0 && (
      <section class="section" style="padding-top: 0;">
        <div class="page-shell">
          <div class="section-header">
            <span class="section-label mono">Also Building</span>
            <h2>其他项目</h2>
          </div>
          <div class="card-grid">
            {rest.map((project) => (
              <a class="card-link" href={`/projects/${project.slug}/`}>
                <div class="panel" style="padding: 1.6rem; height: 100%; display: flex; flex-direction: column;">
                  <div class="mono" style="font-size: 0.72rem; color: var(--text-dim); margin-bottom: 0.9rem; display: flex; justify-content: space-between; letter-spacing: 0.08em; text-transform: uppercase;">
                    <span>{project.data.year}</span>
                    <span style="color: var(--signal);">{project.data.status}</span>
                  </div>
                  <h3 style="margin-bottom: 0.75rem; font-size: 1.15rem;">{project.data.title}</h3>
                  <p style="font-size: 0.92rem; color: var(--text-muted); flex-grow: 1; margin-bottom: 1.15rem;">
                    {project.data.summary}
                  </p>
                  <div class="tag-row">
                    {project.data.stack.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section band">
    <div class="page-shell now-split">
      <div>
        <span class="section-label mono">Now</span>
        <h2>正在关注</h2>
        <p style="margin-top: 1.25rem; font-size: 1.05rem; color: var(--text-muted); line-height: 1.8;">
          公开主线是 Java RAG Lab：把文档问答做成可引用、可拒答、能给面试官点开的东西。站点本身也在迭代。
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap;">
          <a class="btn btn-outline" href="/now">详细状态</a>
          <span class="mono" style="font-size: 0.75rem; color: var(--text-dim);">Last updated: 2026.09</span>
        </div>
      </div>
      <div class="rack now-panel">
        <div class="mono" style="font-size: 0.72rem; letter-spacing: 0.12em; color: var(--signal); margin-bottom: 1rem; text-transform: uppercase;">
          // stack · current
        </div>
        <div class="now-grid">
          <span style="color: var(--text-dim);">[LLM]</span>
          <span>DeepSeek API / 可替换客户端</span>
          <span style="color: var(--text-dim);">[ARCH]</span>
          <span>Hybrid RAG · Citations · Refuse</span>
          <span style="color: var(--text-dim);">[LANG]</span>
          <span>Java 21 / Spring Boot 3</span>
          <span style="color: var(--text-dim);">[INFRA]</span>
          <span>Docker / Cloudflare Tunnel</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
