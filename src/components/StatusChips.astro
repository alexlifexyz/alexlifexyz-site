---
const chips = [
  { live: false, label: "成都" },
  { live: false, label: "Agent / AI" },
  { live: true, label: "开放沟通" },
];
---

<ul class="status-chips" aria-label="Profile">
  {
    chips.map((chip) => (
      <li>
        {chip.live && <i class="led" aria-hidden="true" />}
        {chip.label}
      </li>
    ))
  }
</ul>
